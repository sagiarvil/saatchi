{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saatchi-app",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    "saatchi.watch/*",
    "www.saatchi.watch/*"
  ],
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  }
}

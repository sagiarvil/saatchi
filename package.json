    "@tailwindcss/typography": "^0.5.0-alpha.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "designlang": "^13.3.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "firebase-tools": "^15.30.1",
    "playwright": "^1.63.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "^16.4.4"
  }
}

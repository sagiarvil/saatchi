{
  "name": "saatchi_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:hero": "node scripts/check-hero-autoplay.mjs",
    "check:premium-ui": "node scripts/check-premium-ui-regressions.mjs",
    "check:craft": "node scripts/check-craft-floor.mjs",
    "check:catalog": "node scripts/check-catalog-integrity.mjs",
    "check:vip": "node scripts/check-vip-security.mjs",
    "engine:tokens": "node scripts/designlang-analyzer.mjs",
    "test:e2e": "playwright test",
    "sync:rolex": "node scripts/sync-rolex-chrono24.mjs",
    "sync:pricing": "node scripts/enforce-pricing-invariants.mjs",
    "test:vip": "node --experimental-strip-types scripts/test-vip-behavior.mjs",
    "build:id": "node scripts/write-build-id.mjs",
    "build": "rm -rf .next && node scripts/mobile-ci-gate.mjs && node scripts/seo-ci-gate.mjs && npm run sync:pricing && node scripts/generate-seo-assets.mjs && node scripts/indexnow-submit.mjs && npm run build:id && npm run check:hero && npm run check:premium-ui && npm run check:craft && npm run check:catalog && npm run check:vip && npm run test:vip && npx --yes @tailwindcss/cli -i src/app/globals.css -o src/app/tailwind.css && next build --webpack && echo '{\"sortedMiddleware\":[],\"middleware\":{},\"functions\":{},\"version\":2}' > .next/server/middleware-manifest.json",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "deploy": "firebase deploy"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.46.0",
